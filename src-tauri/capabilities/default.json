{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口的默认权限集合",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "fs:default",
    "fs:allow-write-file",
    "fs:allow-exists",
    "window-state:default",
    {
      "identifier": "http:default",
      "_comment": "scope 使用 URLPattern 语义：必须显式写 * 端口，否则带端口的地址（自建中转、Ollama 等）会被拒绝",
      "allow": [{ "url": "http://*:*" }, { "url": "https://*:*" }]
    }
  ]
}
