new file mode 100644
index 0000000..1018bda
--- /dev/null
+++ b/src/lib/desktop.ts
@@ -0,0 +1,251 @@
+// 桌面端（Tauri）适配层。
+//
+// 上游是纯前端应用，在 WebView 里只有三处与浏览器不同，这里逐一补齐：
+// 1. 服务商 CORS 限制 —— 请求改由 Rust 侧发出；
+// 2. <a download> 行为不可靠 —— 改用原生保存对话框写入磁盘；
+// 3. 外部链接会把应用自身导航走 —— 改用系统默认浏览器打开。
+//
+// 未运行在 Tauri 中时（普通 Web 部署）所有导出函数都退化为浏览器原生行为，
+// 因此该模块对上游的 Web 版本没有副作用。
+
+const TAURI_GLOBAL = '__TAURI_INTERNALS__'
+
+export function isDesktopApp(): boolean {
+  return typeof window !== 'undefined' && TAURI_GLOBAL in window
+}
+
+export interface DesktopFileItem {
+  blob: Blob
+  fileName: string
+}
+
+export interface DesktopSaveResult {
+  successCount: number
+  failCount: number
+}
+
+type BridgedFetch = (input: RequestInfo | URL, init?: RequestInit) => Promise<Response>
+
+let bridgedFetchPromise: Promise<BridgedFetch> | null = null
+let bridgeUnavailable = false
+let installed = false
+
+/** 动态引入插件，避免 Web 部署把桌面端依赖打进主包 */
+function loadBridgedFetch(): Promise<BridgedFetch> {
+  bridgedFetchPromise ??= import('@tauri-apps/plugin-http').then((mod) => mod.fetch as BridgedFetch)
+  return bridgedFetchPromise
+}
+
+function resolveRequestUrl(input: RequestInfo | URL): string {
+  if (typeof input === 'string') return input
+  if (input instanceof URL) return input.href
+  return input.url
+}
+
+function isAppOwnUrl(url: string): boolean {
+  const origin = window.location.origin
+  return url === origin || url.startsWith(`${origin}/`)
+}
+
+// Tauri 自身的 IPC 与资源协议同样走 http(s)：Windows 下 IPC 地址形如
+// http://ipc.localhost/<command>，而 IPC 内部恰恰是用 fetch 发请求的。
+// 如果把这些地址也桥接到 http 插件，插件自身的 invoke 会再次触发 IPC fetch，
+// 形成递归并让整个 IPC 失效（表现为「IPC custom protocol failed」）。
+const TAURI_INTERNAL_HOSTS = new Set(['ipc.localhost', 'asset.localhost', 'tauri.localhost'])
+
+/** 只接管指向外部服务商的绝对 http(s) 请求 */
+function shouldBridge(url: string): boolean {
+  if (!/^https?:\/\//i.test(url)) return false
+  try {
+    if (TAURI_INTERNAL_HOSTS.has(new URL(url).hostname)) return false
+  } catch {
+    return false
+  }
+  return !isAppOwnUrl(url)
+}
+
+/**
+ * 用 Rust 侧请求替换 window.fetch。
+ * 上游所有 API 调用、图片链接下载、流式响应都走这里，因此无需改动业务代码。
+ */
+function installFetchBridge() {
+  const originalFetch = window.fetch.bind(window)
+
+  window.fetch = async (input, init) => {
+    // 桥接是无条件安装的（见 installDesktopIntegration），因此每次请求都要判断
+    // 当前是否真的运行在 Tauri 中；浏览器部署下这里始终走原生 fetch。
+    if (bridgeUnavailable || !isDesktopApp() || !shouldBridge(resolveRequestUrl(input))) {
+      return originalFetch(input, init)
+    }
+
+    let bridgedFetch: BridgedFetch
+    try {
+      bridgedFetch = await loadBridgedFetch()
+    } catch (err) {
+      // 插件整体不可用（例如权限未配置）时降级回 WebView 请求，保留上游的跨域错误提示
+      bridgeUnavailable = true
+      console.error('桌面端请求通道不可用，已降级为 WebView 原生请求', err)
+      return originalFetch(input, init)
+    }
+
+    // 通道正常时不再兜底：真实的网络/HTTP 错误应当原样抛出
+    return bridgedFetch(input, init)
+  }
+}
+
+/** 点击外部链接时交给系统浏览器，避免 WebView 被导航离开应用 */
+function installExternalLinkHandler() {
+  document.addEventListener(
+    'click',
+    (event) => {
+      // 同样在事件触发时判断，浏览器环境下直接放行
+      if (!isDesktopApp()) return
+      if (event.defaultPrevented || event.button !== 0) return
+      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return
+
+      const target = event.target as Element | null
+      const anchor = target?.closest?.('a[href]') as HTMLAnchorElement | null
+      if (!anchor) return
+
+      const href = anchor.href
+      if (!/^https?:\/\//i.test(href) || isAppOwnUrl(href)) return
+
+      event.preventDefault()
+      void openExternalUrl(href)
+    },
+    true,
+  )
+}
+
+async function openExternalUrl(url: string) {
+  try {
+    const { openUrl } = await import('@tauri-apps/plugin-opener')
+    await openUrl(url)
+  } catch (err) {
+    console.error('打开外部链接失败', url, err)
+  }
+}
+
+/** 挂载应用前调用，安装全部桌面端适配 */
+export function installDesktopIntegration() {
+  if (installed) return
+  installed = true
+  // 两者都无条件安装，内部按运行环境自行判断，保证浏览器部署行为不变
+  installFetchBridge()
+  installExternalLinkHandler()
+}
+
+/** 浏览器端的下载兜底，保持与上游一致的行为 */
+export function triggerBrowserDownload(blob: Blob, fileName: string) {
+  const url = URL.createObjectURL(blob)
+  const a = document.createElement('a')
+  a.href = url
+  a.download = fileName
+  document.body.appendChild(a)
+  a.click()
+  a.remove()
+  window.setTimeout(() => URL.revokeObjectURL(url), 1000)
+}
+
+async function writeBlob(path: string, blob: Blob) {
+  const { writeFile } = await import('@tauri-apps/plugin-fs')
+  await writeFile(path, new Uint8Array(await blob.arrayBuffer()))
+}
+
+function splitFileName(fileName: string) {
+  const dot = fileName.lastIndexOf('.')
+  if (dot <= 0) return { base: fileName, extension: '' }
+  return { base: fileName.slice(0, dot), extension: fileName.slice(dot) }
+}
+
+/** 单个文件走「另存为」，由系统对话框负责重名确认 */
+async function resolveSingleTarget(file: DesktopFileItem) {
+  const { save } = await import('@tauri-apps/plugin-dialog')
+  const extension = splitFileName(file.fileName).extension.replace('.', '')
+  const path = await save({
+    defaultPath: file.fileName,
+    filters: extension ? [{ name: extension.toUpperCase(), extensions: [extension] }] : undefined,
+  })
+  return path ? [{ path, blob: file.blob }] : null
+}
+
+/** 多个文件只弹一次目录选择，并在目录内自动避让重名 */
+async function resolveDirectoryTargets(files: DesktopFileItem[]) {
+  const { open } = await import('@tauri-apps/plugin-dialog')
+  const { exists } = await import('@tauri-apps/plugin-fs')
+  const { join } = await import('@tauri-apps/api/path')
+
+  const directory = await open({
+    directory: true,
+    recursive: true,
+    title: `选择保存 ${files.length} 个文件的文件夹`,
+  })
+  if (typeof directory !== 'string') return null
+
+  // 重名时追加序号，避免覆盖已有文件；检查失败时放弃避让，但不能让整批保存失败
+  const isTaken = async (name: string) => {
+    try {
+      return await exists(await join(directory, name))
+    } catch (err) {
+      console.warn('检查目标文件是否存在失败，将直接写入', err)
+      return false
+    }
+  }
+
+  const targets: Array<{ path: string; blob: Blob }> = []
+  for (const file of files) {
+    const { base, extension } = splitFileName(file.fileName)
+    let name = file.fileName
+    let index = 2
+    while (await isTaken(name)) {
+      name = `${base}-${index}${extension}`
+      index++
+    }
+    targets.push({ path: await join(directory, name), blob: file.blob })
+  }
+  return targets
+}
+
+/**
+ * 保存一批文件。
+ * 桌面端弹出原生对话框，返回实际写入成功/失败的数量；
+ * 用户取消时返回 0/0，方便调用方区分「取消」与「失败」。
+ */
+export async function saveFiles(files: DesktopFileItem[]): Promise<DesktopSaveResult> {
+  if (files.length === 0) return { successCount: 0, failCount: 0 }
+
+  if (!isDesktopApp()) {
+    // 与上游一致：多文件连续下载之间留出间隔，否则浏览器可能只放行第一张
+    for (let index = 0; index < files.length; index++) {
+      triggerBrowserDownload(files[index].blob, files[index].fileName)
+      if (files.length > 1) await delay(100)
+    }
+    return { successCount: files.length, failCount: 0 }
+  }
+
+  const targets =
+    files.length === 1 ? await resolveSingleTarget(files[0]) : await resolveDirectoryTargets(files)
+  if (!targets) return { successCount: 0, failCount: 0 }
+
+  let successCount = 0
+  let failCount = 0
+  for (const target of targets) {
+    try {
+      await writeBlob(target.path, target.blob)
+      successCount++
+    } catch (err) {
+      console.error('保存文件失败', target.path, err)
+      failCount++
+    }
+  }
+  return { successCount, failCount }
+}
+
+/** 保存单个文件，常用于导出备份 */
+export async function saveBlob(blob: Blob, fileName: string): Promise<DesktopSaveResult> {
+  return saveFiles([{ blob, fileName }])
+}
+
+function delay(ms: number) {
+  return new Promise((resolve) => window.setTimeout(resolve, ms))
+}
